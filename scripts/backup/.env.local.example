# Copiá este archivo como ".env.local" (ya ignorado por git) y completá el password real.
# Lo encontrás en: Supabase Dashboard > Settings > Database > Connection string > "Session pooler".
# Importante: usamos el pooler (no la conexión "directa") porque el host directo
# (db.<ref>.supabase.co) solo resuelve por IPv6, y los contenedores de Docker
# Desktop en Windows no tienen salida IPv6 -> pg_dump falla con "Name or service not known".
# Si no tenés el password guardado, podés resetearlo desde la misma pantalla.
SUPABASE_DB_URL=postgres://postgres.ojbdljecdvjgsbthouvf:TU_PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres
